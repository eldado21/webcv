# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4

[*.ts]
indent_size = 2
quote_type = single
ij_typescript_use_double_quotes = false

[src/app/interfaces/*.ts]
indent_size = 4

[{package.json,package-lock.json,angular.json,tsconfig*.json}]
indent_size = 2

[*.yml]
indent_size = 2

[*.md]
max_line_length = off
